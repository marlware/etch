{
  "family": "etch-sms-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/etchEcsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/etchSmsServiceTaskRole",
  "containerDefinitions": [
    {
      "name": "sms-service",
      "image": "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/etch-sms-service:latest",
      "essential": true,
      "portMappings": [
        { "containerPort": 8084, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "SMS_FAILURE_RATE", "value": "0.05" },
        { "name": "SMS_UNAVAILABLE_RATE", "value": "0.0" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/etch/sms-service",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "sms-service",
          "awslogs-create-group": "true"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -q -O- http://localhost:8084/actuator/health/liveness || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      }
    }
  ]
}
